import java.util.Scanner;

public class GradeStatistics {
    public static final int TOTAL_GRADES = 10;
    public static final float MIN_GRADE = 0.0f;
    public static final float MAX_GRADE = 100.0f;
public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        float sum = 0.0f;
        float maximum = MIN_GRADE; 
        float minimum = MAX_GRADE; 
        System.out.println("Please enter " + TOTAL_GRADES + " grades between 0.0 and 100.0.");

        for (int i = 1; i <= TOTAL_GRADES; i++) {
            float currentGrade = -1.0f;
            boolean isValid = false;
            while (!isValid) {
                System.out.print("Enter grade #" + i + ": ");
                
                if (scanner.hasNextFloat()) {
                    currentGrade = scanner.nextFloat();
                    
                    if (currentGrade >= MIN_GRADE && currentGrade <= MAX_GRADE) {
                        isValid = true;
                    } else {
                        System.out.println("Invalid range! Grade must be between 0.0 and 100.0. Please try again.");
                    }
                } else {
                    System.out.println("Invalid input type! Please enter a valid floating-point number.");
                    scanner.next();
                }
            }

            sum += currentGrade;
            if (currentGrade > maximum) {
                maximum = currentGrade;
            }
            if (currentGrade < minimum) {
                minimum = currentGrade;
            }
        }

        float average = sum / TOTAL_GRADES;

        System.out.println("\n--- Grade Statistics ---");
        System.out.printf("Average: %.2f\n", average);
        System.out.printf("Maximum: %.2f\n", maximum);
        System.out.printf("Minimum: %.2f\n", minimum);

        scanner.close();
    }
}
